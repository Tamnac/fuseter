{
  "name": "fuseter",
  "version": "0.2.1",
  "license": "MIT",
  "description": "Rank-identical, much faster replacement for Fuse.search (ignoreLocation: true) with js, wasm and wasm-simd backends",
  "keywords": [
    "fuzzy",
    "search",
    "fuse",
    "fuse.js",
    "bitap",
    "wasm",
    "simd",
    "webassembly"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tamnac/fuseter.git"
  },
  "bugs": {
    "url": "https://github.com/Tamnac/fuseter/issues"
  },
  "homepage": "https://github.com/Tamnac/fuseter#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./js": {
      "types": "./src/index.d.ts",
      "default": "./src/js.mjs"
    },
    "./wasm": {
      "types": "./src/index.d.ts",
      "default": "./src/wasm.mjs"
    },
    "./simd": {
      "types": "./src/index.d.ts",
      "default": "./src/simd.mjs"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "fuse.js": "^7.5.0"
  }
}
